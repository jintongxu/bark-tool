<Window x:Class="BarkTool.Desktop.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="260" Height="260" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True">
    <Window.Resources>
        <Style x:Key="OrbitButton" TargetType="Button">
            <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="#5B6579"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="23"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.IsEnabled" Value="False"/>
            <EventSetter Event="MouseEnter" Handler="Action_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="Action_MouseLeave"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Circle" Background="{TemplateBinding Background}" CornerRadius="24">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#E9EDFF"/><Setter Property="Foreground" Value="#637AE7"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="Background" Value="#E9EDFF"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Background" Value="#DCE3FF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Button x:Name="CaptureButton" Style="{StaticResource OrbitButton}" ToolTip="框选截图" AutomationProperties.Name="框选截图"
                HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" Margin="0,30,30,0" Click="Capture_Click" Panel.ZIndex="2">
            <Path Data="M2,9 L2,2 9,2 M15,2 L22,2 22,9 M22,15 L22,22 15,22 M9,22 L2,22 2,15" Stroke="#5B6579" StrokeThickness="2" Width="19" Height="19" Stretch="Uniform"/>
        </Button>
        <Ellipse Fill="#F9FAFE" Stroke="#DCE0E8" StrokeThickness="1"/>
        <Ellipse Width="112" Height="112" Stroke="#D4D9E2" StrokeThickness="1.5" Fill="#F4F6FB"/>
        <Button x:Name="ComposeButton" Style="{StaticResource OrbitButton}" ToolTip="写内容" AutomationProperties.Name="写内容"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,13,0,0" Click="Compose_Click">
            <Path Data="M3,17 L3,21 7,21 21,7 17,3 Z M14,6 L18,10" Stroke="#5B6579" StrokeThickness="2" Width="23" Height="23" Stretch="Uniform"/>
        </Button>
        <Button x:Name="ClipboardButton" Style="{StaticResource OrbitButton}" ToolTip="直接发送剪贴板" AutomationProperties.Name="直接发送剪贴板"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" Click="Clipboard_Click">
            <Path Data="M7,4 L3,4 3,23 21,23 21,4 17,4 M8,1 L16,1 16,7 8,7 Z M7,12 L17,12 M7,17 L15,17" Stroke="#5B6579" StrokeThickness="2" Width="23" Height="23" Stretch="Uniform"/>
        </Button>
        <Button x:Name="ImageButton" Style="{StaticResource OrbitButton}" ToolTip="选择图片" AutomationProperties.Name="选择图片"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,13" Click="Image_Click">
            <Path Data="M2,2 L24,2 24,23 2,23 Z M3,20 L10,12 15,18 19,14 24,20 M18,7 A2,2 0 1 1 17.99,7" Stroke="#5B6579" StrokeThickness="2" Width="24" Height="23" Stretch="Uniform"/>
        </Button>
        <Button x:Name="SettingsButton" Style="{StaticResource OrbitButton}" ToolTip="设置" AutomationProperties.Name="设置"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" Click="Settings_Click">
            <Path Data="M2,5 L24,5 M2,12 L24,12 M2,19 L24,19 M8,1 L8,9 M18,8 L18,16 M10,15 L10,23" Stroke="#5B6579" StrokeThickness="2.5" Width="24" Height="23" Stretch="Uniform"/>
        </Button>
        <Button x:Name="CollapseButton" Style="{StaticResource OrbitButton}" Width="52" Height="52" Background="#E2E8FF"
                Foreground="#7186F0" ToolTip="收起" AutomationProperties.Name="收起" Click="Collapse_Click">
            <Canvas Width="28" Height="28">
                <Ellipse Width="9" Height="9" Fill="#7B8FF2" Canvas.Left="9.5" Canvas.Top="1"/>
                <Ellipse Width="9" Height="9" Fill="#7B8FF2" Canvas.Left="1" Canvas.Top="9.5"/>
                <Ellipse Width="9" Height="9" Fill="#7B8FF2" Canvas.Left="18" Canvas.Top="9.5"/>
                <Ellipse Width="9" Height="9" Fill="#7B8FF2" Canvas.Left="9.5" Canvas.Top="18"/>
            </Canvas>
        </Button>
        <TextBlock x:Name="HoverLabel" Text="选择操作" FontSize="11" Foreground="#5B6579"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,78,0,0"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
