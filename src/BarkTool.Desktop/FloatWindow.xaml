<Window x:Class="BarkTool.Desktop.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="40" Height="40" AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">
    <Border x:Name="Bubble" BorderThickness="1" CornerRadius="17" Margin="3" Cursor="Hand"
            MouseLeftButtonDown="Bubble_Down" MouseRightButtonUp="Bubble_RightClick">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                            <GradientStop Color="#FFFEFC" Offset="0"/>
                            <GradientStop Color="#F4F6FA" Offset="0.55"/>
                            <GradientStop Color="#E8EDF5" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="#D5DDE8"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#AEBED6"/>
                        <Setter Property="Background" Value="#FAFCFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect Color="#64748B" BlurRadius="4" ShadowDepth="1" Opacity="0.20"/>
        </Border.Effect>
        <Path Data="M4,18 L18,4 M7,4 L18,4 18,15" StrokeThickness="1.8"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"
              VerticalAlignment="Center" IsHitTestVisible="False">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#91A5BD" Offset="0"/>
                    <GradientStop Color="#697FA0" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>
    </Border>
</Window>
