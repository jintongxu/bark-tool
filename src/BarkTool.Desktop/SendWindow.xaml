<Window x:Class="BarkTool.Desktop.SendWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="pack://application:,,,/BarkTool;component/Resources/bark.ico"
        Title="Bark · 快速发送" Width="490" Height="600" MinWidth="450" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#111827"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#243147"/>
            <Setter Property="Foreground" Value="#DFE8F6"/>
            <Setter Property="BorderBrush" Value="#36465E"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#67DCC5"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#67DCC5"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.75"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.48"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#172235"/>
            <Setter Property="Foreground" Value="#EDF3FC"/>
            <Setter Property="CaretBrush" Value="#67DCC5"/>
            <Setter Property="SelectionBrush" Value="#346E76"/>
            <Setter Property="BorderBrush" Value="#34435B"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="#67DCC5"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputSurface" Property="Opacity" Value="0.65"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="ContentRow" Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24">
            <Button x:Name="SettingsButton" Content="设置" DockPanel.Dock="Right" Click="Settings_Click" Padding="12,7" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock x:Name="Heading" Text="发送到 iPhone" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock x:Name="Subtitle" Text="文字与图片，随手送达" Foreground="#94A6BF" FontSize="12" Margin="0,7,0,0"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="BodyLabel" Grid.Row="1" Text="消息内容" Foreground="#BCC9DB" FontSize="12" Margin="1,0,0,9"/>
        <TextBox x:Name="BodyBox" Grid.Row="2" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True" VerticalContentAlignment="Top" MinHeight="150"/>
        <Border Grid.Row="3" Margin="0,14,0,18" Padding="12" Background="#192438" BorderBrush="#2D3C53" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="移除" Click="ClearImage_Click" Padding="9,6" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Border x:Name="PreviewFrame" Width="52" Height="52" Background="#222F45" CornerRadius="8" DockPanel.Dock="Left" Margin="0,0,12,0">
                    <Image x:Name="Preview" Margin="3" Stretch="Uniform" ToolTip="多选图片将逐张发送"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="图片附件" FontSize="12" Foreground="#DCE6F5" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ImageLabel" Text="拖入图片，Ctrl+V 粘贴，或点击下方选择" Foreground="#92A4BF" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button x:Name="CancelButton" Content="取消" Visibility="Collapsed" DockPanel.Dock="Right" Click="Cancel_Click" Margin="8,0,0,0"/>
            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="发送 ↗" Background="#22695F" BorderBrush="#398B7B"
                    Foreground="#E4FFF7" Click="Send_Click" Padding="22,10"/>
            <Button Content="直发剪贴板" ToolTip="直接发送剪贴板中的文字或截图" Click="Clipboard_Click" Margin="0,0,8,0"/>
            <Button Content="选择图片" Click="ChooseImage_Click"/>
        </DockPanel>
        <Border Grid.Row="5" Margin="0,16,0,0" Padding="2,0">
            <StackPanel>
                <ProgressBar x:Name="SendingProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                             Foreground="#67DCC5" Background="#243147" BorderThickness="0" Margin="0,0,0,9"/>
                <TextBlock x:Name="Status" Text="准备就绪" Foreground="#8FCBBD" FontSize="12" TextWrapping="Wrap" MinHeight="32"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
